# BotFather'dan olingan tokenni shu yerga qo'ying
BOT_TOKEN=123456789:AAExampleTokenHere

# Admin(lar) Telegram ID raqami(lari), vergul bilan ajrating: 111111111,222222222
# ID ni bilish uchun @userinfobot ga /start bosing
ADMIN_IDS=111111111

# (Ixtiyoriy) Buyurtmalar tushadigan guruh ID (masalan -1001234567890)
ORDER_GROUP_ID=

# Ma'lumotlar bazasi fayli nomi (o'zgartirish shart emas)
DB_PATH=bot_database.db

# Do'kon nomi (AI javoblarida ishlatiladi)
SHOP_NAME=iTech Kompyuter Savdo Markazi

# ---------------- AI (OpenRouter) ----------------
# https://openrouter.ai saytidan BEPUL ro'yxatdan o'tib olinadi
# Bo'sh qoldirsangiz, AI avto-javob o'chirilib, oddiy xabar ko'rsatiladi
AI_API_KEY=
# Model nomi — https://openrouter.ai/models sahifasida boshqa modellarni ham tanlashingiz mumkin
AI_MODEL=openai/gpt-4o-mini
